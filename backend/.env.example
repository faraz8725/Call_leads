# Server Port & Mode
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ai_voice_calling_platform

# Authentication
JWT_SECRET=super_secret_jwt_signature_key_2026_production_voice
JWT_EXPIRES_IN=7d

# Groq LLM API (Groq Brain)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram Speech-To-Text API
DEEPGRAM_API_KEY=

# Sarvam AI Text-To-Speech (Hindi / English / Hinglish)
SARVAM_API_KEY=

# LiveKit Real-Time WebRTC Voice Infrastructure
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Vobiz Outbound Telephony Provider
VOBIZ_API_KEY=
VOBIZ_API_SECRET=
VOBIZ_BASE_URL=https://api.vobiz.ai/v1
VOBIZ_PHONE_NUMBER=+18005550199

# Frontend URL
FRONTEND_URL=http://localhost:5173
